# Copy to `.env` and fill in to enable the AI tutor (never commit .env)
# Google AI Studio (Gemini):
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=your-api-key-here
AI_MODEL=gemini-3.8-flash

# Optional TURN relay for WebRTC. Without a TURN server, peers behind
# carrier-grade NAT (mobile data) may not see each other's video.
# Get credentials from Metered, Twilio, Cloudflare Calls, or your own coturn.
# Comma-separate multiple URLs.
# TURN_URLS=turn:your-turn-host:3478,turn:your-turn-host:3478?transport=tcp
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-password